{%- comment -%}
============================================================
FAMBOX Design System — Tokens v0.5
snippets/fambox-tokens.css.liquid
============================================================
全 fambox-* section から `{% render 'fambox-tokens.css' %}` で読み込み、
:root に CSS 変数として宣言。

由来: brand/fambox/design-system/current.md §1-A 〜 §1-J（v0.5）
      operations/tokens-extracted.md（実装からの逆抽出）

更新規律（学び 111）:
  - 値を変える時は current.md §1 と同時更新
  - 新規追加は Session 番号マーカー付き
  - Tokens Studio 連携は v0.4-dashboard 候補

使い方:
  {% render 'fambox-tokens.css' %}
  ↓
  <style>:root { ... }</style>

注意:
  - Shopify theme で <head> 内に展開される想定
  - 各 section は本 snippet を render した後、CSS で var() 参照
  - var() fallback は本来不要だが、Shopify エディタプレビューで
    snippet 未 render の場合に備えて inline 直値を残す段階置換中
============================================================
{%- endcomment -%}

<style data-fambox-tokens="v0.5">
:root {
  /* ========================================
     1-A. Color Tokens
     ======================================== */

  /* 1-1 Primary（Drive）— 4値 / Session #48 hover 追加 */
  --color-drive: #FB4C15;
  --color-drive-hover: #e14710;
  --color-drive-light: #FC825B;
  --color-drive-glow: rgba(251, 76, 21, 0.32);  /* glow shadow 用 */

  /* 1-2 Secondary（Sky/Deep）— 2値 */
  --color-sky: #4a90e2;     /* 仮値・v0.6 で確定 */
  --color-deep: #2c3e50;    /* 仮値・v0.6 で確定 */

  /* 1-3 Ink / Text — 5段階 */
  --color-ink: #1b1d1a;             /* main text */
  --color-sub: #5c5f58;             /* secondary text */
  --color-caption: #8a8d87;         /* caption / meta */
  --color-placeholder: #dddddd;     /* placeholder text */
  --color-white: #ffffff;           /* on-dark text / pure white */

  /* 1-4 Background — 3階層 */
  --bg-primary: #ffffff;
  --bg-secondary: #fafafa;
  --bg-tertiary: #f3f3f3;

  /* 1-5 Border — 4値 / Session #48 soft 追加 */
  --border-light: rgba(27, 29, 26, 0.08);   /* hairline divider */
  --border-base: #ececec;                   /* form / card border */
  --border-soft: #d0d1db;                   /* section divider 1-2px */
  --border-subtle: rgba(27, 29, 26, 0.04);  /* extremely soft */

  /* 1-6 Semantic — 4値 */
  --color-success: #2e7d32;
  --color-warning: #f57c00;
  --color-error: #d32f2f;
  --color-info: #1976d2;

  /* 1-7 Data Color Palette — 6値（仮 / v0.6 で確定） */
  --color-data-1: #FB4C15;  /* drive */
  --color-data-2: #2e7d32;  /* success-green */
  --color-data-3: #1976d2;  /* info-blue */
  --color-data-4: #f57c00;  /* warning-orange */
  --color-data-5: #7b1fa2;  /* purple */
  --color-data-6: #00838f;  /* teal */

  /* 1-8 Glass Opacity — 5階調（spec §1-A 1-8） */
  --glass-1: rgba(0, 0, 0, 0.05);
  --glass-2: rgba(0, 0, 0, 0.1);
  --glass-3: rgba(0, 0, 0, 0.3);
  --glass-4: rgba(0, 0, 0, 0.6);
  --glass-5: rgba(0, 0, 0, 0.8);

  /* 1-8b White overlay scale（de facto / Session #47 抽出） */
  --white-overlay-04: rgba(255, 255, 255, 0.04);
  --white-overlay-08: rgba(255, 255, 255, 0.08);
  --white-overlay-10: rgba(255, 255, 255, 0.1);
  --white-overlay-15: rgba(255, 255, 255, 0.15);
  --white-overlay-30: rgba(255, 255, 255, 0.3);
  --white-overlay-60: rgba(255, 255, 255, 0.6);
  --white-overlay-85: rgba(255, 255, 255, 0.85);
  --white-overlay-90: rgba(255, 255, 255, 0.9);

  /* 1-8c Ink overlay scale（footer 上 等で多用） */
  --ink-overlay-04: rgba(27, 29, 26, 0.04);
  --ink-overlay-06: rgba(27, 29, 26, 0.06);
  --ink-overlay-08: rgba(27, 29, 26, 0.08);
  --ink-overlay-16: rgba(27, 29, 26, 0.16);
  --ink-overlay-20: rgba(27, 29, 26, 0.2);

  /* 1-9 Semantic Alias — 意味参照 */
  --color-cta: var(--color-drive);
  --color-cta-hover: var(--color-drive-hover);
  --color-focus-ring: var(--color-drive);
  --color-disabled: #b3b5b0;
  --color-link: var(--color-drive);
  --color-link-hover: var(--color-drive-hover);

  /* ========================================
     1-B. Typography Tokens
     ======================================== */

  /* font-family */
  --font-ja: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Meiryo', sans-serif;
  --font-en: 'Poppins', sans-serif;

  /* font-weight — 4段階 */
  --fw-regular: 400;
  --fw-medium: 500;
  --fw-semibold: 600;
  --fw-bold: 700;

  /* font-size scale（v0.5 拡張: 13/15/18/28/40/56 を追加） */
  --fs-caption: 12px;       /* caption / meta */
  --fs-caption-lg: 13px;
  --fs-body-sm: 14px;
  --fs-body-md: 15px;
  --fs-body: 16px;          /* body 標準 */
  --fs-body-lg: 18px;
  --fs-h4: 20px;
  --fs-h3: 24px;
  --fs-h3-mobile: 28px;     /* SP の h2 相当 */
  --fs-h2: 32px;
  --fs-h2-large: 40px;      /* PC tall title */
  --fs-h1: 48px;
  --fs-display: 56px;       /* stat-focus value */
  --fs-hero: 64px;          /* hero stat */
  --fs-mega: 96px;          /* mega numbers */

  /* line-height — 5段階 / Session #48 拡張 */
  --lh-tight: 1.2;          /* heading H1/H2 */
  --lh-heading: 1.4;        /* heading H3/H4 */
  --lh-base: 1.5;           /* caption / form field */
  --lh-body: 1.75;          /* body 標準 */
  --lh-relaxed: 1.8;        /* quote / 強調本文 */

  /* letter-spacing */
  --ls-en: -0.02em;
  --ls-ja: 0.02em;
  --ls-uppercase: 0.12em;   /* eyebrow uppercase */
  --ls-button: 0.04em;      /* button label */

  /* ========================================
     1-C. Spacing Tokens — 11段階 / Session #48 拡張
     ======================================== */
  --space-0-5: 4px;
  --space-1: 8px;
  --space-1-5: 12px;
  --space-2: 16px;
  --space-3: 24px;
  --space-4: 32px;
  --space-4-5: 40px;
  --space-5: 48px;
  --space-6: 64px;
  --space-7: 96px;
  --space-8: 120px;

  /* Section spacing（spec §1-C 1-19 / Session #48 で 160→120 修正） */
  --section-spacing-sp: 96px;
  --section-spacing-pc: 120px;

  /* ========================================
     1-D. Motion Tokens — Session #48 で 150/300/600 → 150/250/350 修正
     ======================================== */
  --duration-fast: 150ms;
  --duration-base: 250ms;
  --duration-slow: 350ms;

  --ease-out: ease-out;
  --ease-in: ease-in;
  --ease-in-out: ease-in-out;

  /* breathing アニメ（呼吸 2秒） */
  --duration-breathing: 2000ms;

  /* ========================================
     1-E. Elevation / Shadow Tokens — 5段階
     ======================================== */
  --shadow-1: 0 1px 2px rgba(0, 0, 0, 0.04);                      /* hairline */
  --shadow-2: 0 4px 8px rgba(0, 0, 0, 0.08);
  --shadow-3: 0 8px 16px rgba(0, 0, 0, 0.12);                     /* card hover */
  --shadow-4: 0 12px 24px rgba(0, 0, 0, 0.16);
  --shadow-5: 0 24px 48px rgba(0, 0, 0, 0.24);                    /* modal */

  /* Drive 強調影（CTA hover で使用） */
  --shadow-drive-glow: 0 8px 16px rgba(251, 76, 21, 0.24);

  /* ========================================
     1-F. Radius Tokens
     ======================================== */
  --radius-xs: 2px;       /* badge 角 */
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 16px;      /* sheet modal 上端 */
  --radius-circle: 50%;   /* avatar / icon button */
  --radius-pill-cta: 50px;  /* CTA button pill (spec §1-F 1-25) */
  --radius-pill: 9999px;  /* full pill */

  /* ========================================
     1-G. Breakpoint Tokens — 4段階 / Session #48 SP-sm 追加
     ======================================== */
  --bp-sp-sm: 480px;      /* Header / Modal SP small（actions 縦並び切替）*/
  --bp-sp-max: 767px;     /* SP 上限 */
  --bp-tablet: 768px;     /* Tablet 下限 */
  --bp-pc: 1024px;        /* PC 下限 */
  --container-max: 1440px;

  /* ========================================
     1-H. Z-index Tokens — scale
     ======================================== */
  --layer-base: 1;
  --layer-1: 2;            /* card hover lift */
  --layer-2: 10;           /* dropdown / tooltip */
  --layer-3: 50;           /* sticky CTA bar */
  --layer-4: 100;          /* Header / Drawer */
  --layer-5: 1000;         /* Modal / Overlay */
  --layer-6: 9999;         /* Toast / Critical alert */

  /* ========================================
     1-I. Icon Tokens
     ======================================== */
  --icon-xs: 16px;
  --icon-sm: 20px;
  --icon-md: 24px;
  --icon-lg: 32px;
  --icon-xl: 48px;
  --icon-stroke: 1.5px;   /* spec §1-I 1-29 */
}

{%- comment -%}
============================================================
prefers-reduced-motion: アニメ無効化のフォールバック
spec §1-D との連携
============================================================
{%- endcomment -%}
@media (prefers-reduced-motion: reduce) {
  :root {
    --duration-fast: 0ms;
    --duration-base: 0ms;
    --duration-slow: 0ms;
    --duration-breathing: 0ms;
  }
}
</style>
