<!-- ============================================
     FAMBOX Footer Section
     sections/fambox-footer.liquid
     Spec: brand/fambox/design-system/components/footer.md (v0.2)
     Figma Component Set: 60:95
     ============================================
     3 Variants（spec §Variants 準拠）:
       - Standard: Brand + Nav columns (3) + Social + Bottom row
       - Minimal:  Brand + Bottom row のみ（LP / Checkout 向け）
       - Sitemap:  Brand + Nav columns (4) + Social + Bottom row
     共通規律:
       - 背景: Ink (var(--color-ink)) 単色固定（Drive ベタ塗り禁止）
       - SNS: 40×40px 上限（Display サイズ禁止）
       - Bottom: Copyright + Legal links（Privacy / Terms / 特商法）のみ
       - CTA / メルマガ / Payment methods 禁止（v0.3 以降）
     ============================================ -->
{%- liquid
  assign sec_id = 'fambox-footer-' | append: section.id
  assign variant = section.settings.variant | default: 'standard'

  assign has_sns = false
  if section.settings.sns_instagram != blank or section.settings.sns_youtube != blank or section.settings.sns_note != blank or section.settings.sns_x != blank or section.settings.sns_tiktok != blank
    assign has_sns = true
  endif
-%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@600&display=swap');

  /* ============================================
     RESET
     ============================================ */
  #{{ sec_id }},
  #{{ sec_id }} *,
  #{{ sec_id }} *::before,
  #{{ sec_id }} *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* ============================================
     FOOTER 基本（全 Variants 共通）
     Ink (var(--color-ink)) 単色固定
     ============================================ */
  #{{ sec_id }} .footer {
    background: var(--color-ink) !important;
    color: var(--color-white);
    isolation: isolate;
    font-family: var(--font-ja) !important;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* ============================================
     MAIN（SP 96px / PC 160px padding）
     ============================================ */
  #{{ sec_id }} .footer__main {
    padding: 96px 0;
  }
  @media (min-width: 1024px) {
    #{{ sec_id }} .footer__main {
      padding: 160px 0;
    }
  }

  /* ============================================
     INNER（PC: row / SP: column）
     ============================================ */
  #{{ sec_id }} .footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 var(--space-3);
  }
  @media (min-width: 1024px) {
    #{{ sec_id }} .footer__inner {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--space-6);
      padding: 0 var(--space-6);
    }
  }

  /* ============================================
     BRAND AREA
     ============================================ */
  #{{ sec_id }} .footer__brand {
    flex: 0 0 auto;
    max-width: 320px;
  }
  #{{ sec_id }} .footer__logo {
    height: 40px;
    width: auto;
    display: block;
  }
  #{{ sec_id }} .footer__logo svg,
  #{{ sec_id }} .footer__logo img {
    height: 40px;
    width: auto;
    display: block;
  }
  #{{ sec_id }} .footer__tagline {
    margin-top: var(--space-2) !important;
    font-family: var(--font-ja) !important;
    font-size: var(--fs-body-sm) !important;
    font-weight: var(--fw-regular) !important;
    color: rgba(255, 255, 255, 0.7) !important;
    line-height: 1.75 !important;
    letter-spacing: normal !important;
    text-transform: none !important;
  }

  /* ============================================
     NAV（Standard 3 列 / Sitemap 4 列 / SP 1 列）
     ============================================ */
  #{{ sec_id }} .footer__nav {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    list-style: none;
  }
  @media (max-width: 1023px) {
    #{{ sec_id }} .footer__nav {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 767px) {
    #{{ sec_id }} .footer__nav {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
  #{{ sec_id }} .footer__nav-heading {
    font-family: var(--font-en) !important;
    font-size: var(--fs-body) !important;
    font-weight: var(--fw-semibold) !important;
    color: var(--color-white) !important;
    letter-spacing: 0.02em !important;
    margin-bottom: var(--space-2) !important;
    line-height: 1.4 !important;
    text-transform: none !important;
  }
  #{{ sec_id }} .footer__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  #{{ sec_id }} .footer__link {
    font-family: var(--font-ja) !important;
    font-size: var(--fs-body-sm) !important;
    font-weight: var(--fw-regular) !important;
    color: var(--color-white) !important;
    text-decoration: none !important;
    letter-spacing: normal !important;
    line-height: 1.7 !important;
    transition: color var(--duration-fast) var(--ease-out);
  }
  #{{ sec_id }} .footer__link:hover {
    color: var(--color-drive) !important;
  }
  #{{ sec_id }} .footer__link:focus-visible {
    outline: 2px solid var(--color-drive);
    outline-offset: 2px;
  }

  /* ============================================
     SOCIAL（40×40 上限 / Display サイズ禁止）
     ============================================ */
  #{{ sec_id }} .footer__social {
    flex: 0 0 auto;
  }
  #{{ sec_id }} .footer__social-heading {
    font-family: var(--font-en) !important;
    font-size: var(--fs-body) !important;
    font-weight: var(--fw-semibold) !important;
    color: var(--color-white) !important;
    letter-spacing: 0.02em !important;
    margin-bottom: var(--space-2) !important;
    line-height: 1.4 !important;
  }
  #{{ sec_id }} .footer__social-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  #{{ sec_id }} .footer__social-list a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-white);
    transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
    text-decoration: none;
  }
  #{{ sec_id }} .footer__social-list a:hover {
    background: var(--color-drive);
  }
  #{{ sec_id }} .footer__social-list a:focus-visible {
    outline: 2px solid var(--color-drive);
    outline-offset: 2px;
  }
  #{{ sec_id }} .footer__social-list svg {
    width: 20px;
    height: 20px;
    display: block;
    fill: currentColor;
  }

  /* ============================================
     BOTTOM ROW（Copyright + Legal）
     ============================================ */
  #{{ sec_id }} .footer__bottom {
    background: rgba(0, 0, 0, 0.3);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 24px 0;
  }
  #{{ sec_id }} .footer__bottom-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 var(--space-3);
    font-size: var(--fs-caption);
    color: rgba(255, 255, 255, 0.6);
  }
  @media (min-width: 768px) {
    #{{ sec_id }} .footer__bottom-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: 0 var(--space-6);
    }
  }
  #{{ sec_id }} .footer__copyright {
    margin: 0 !important;
    font-family: var(--font-ja) !important;
    font-size: var(--fs-caption) !important;
    font-weight: var(--fw-regular) !important;
    color: rgba(255, 255, 255, 0.6) !important;
    letter-spacing: normal !important;
    line-height: 1.5 !important;
  }
  #{{ sec_id }} .footer__legal {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  #{{ sec_id }} .footer__legal a {
    color: rgba(255, 255, 255, 0.6) !important;
    text-decoration: none !important;
    font-family: var(--font-ja) !important;
    font-size: var(--fs-caption) !important;
    transition: color var(--duration-fast) var(--ease-out);
  }
  #{{ sec_id }} .footer__legal a:hover {
    color: var(--color-white) !important;
  }

  /* ============================================
     VARIANT: Minimal（Nav / Social を非表示）
     ============================================ */
  #{{ sec_id }} .footer-minimal .footer__nav,
  #{{ sec_id }} .footer-minimal .footer__social {
    display: none !important;
  }

  /* ============================================
     VARIANT: Sitemap（Nav 4 列）
     ============================================ */
  #{{ sec_id }} .footer-sitemap .footer__nav {
    grid-template-columns: repeat(4, 1fr);
  }
  @media (max-width: 1023px) {
    #{{ sec_id }} .footer-sitemap .footer__nav {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 767px) {
    #{{ sec_id }} .footer-sitemap .footer__nav {
      grid-template-columns: 1fr;
    }
  }

  /* ============================================
     prefers-reduced-motion
     ============================================ */
  @media (prefers-reduced-motion: reduce) {
    #{{ sec_id }} .footer__link,
    #{{ sec_id }} .footer__legal a,
    #{{ sec_id }} .footer__social-list a {
      transition: none !important;
    }
  }
</style>

<section id="{{ sec_id }}">
  <footer class="footer footer-{{ variant }}" role="contentinfo">

    {%- comment -%} ===== MAIN（Brand + Nav + Social）===== {%- endcomment -%}
    <div class="footer__main">
      <div class="footer__inner">

        {%- comment -%} ----- Brand Area ----- {%- endcomment -%}
        <div class="footer__brand">
          {%- if section.settings.footer_logo_svg != blank -%}
            <div class="footer__logo">{{ section.settings.footer_logo_svg }}</div>
          {%- elsif section.settings.footer_logo != blank -%}
            <div class="footer__logo">
              {{ section.settings.footer_logo | image_url: width: 256 | image_tag:
                alt: shop.name,
                width: 120,
                height: 40,
                loading: 'lazy',
                class: 'footer__logo-img'
              }}
            </div>
          {%- endif -%}

          {%- if section.settings.footer_tagline != blank -%}
            <p class="footer__tagline">{{ section.settings.footer_tagline | newline_to_br }}</p>
          {%- endif -%}
        </div>

        {%- comment -%} ----- Nav Columns（Standard / Sitemap のみ表示）----- {%- endcomment -%}
        {%- if variant != 'minimal' -%}
          <nav class="footer__nav" aria-label="{%- if variant == 'sitemap' -%}サイトマップ{%- else -%}フッターナビゲーション{%- endif -%}">
            {%- for block in section.blocks -%}
              {%- if block.type == 'nav_column' -%}
                <div class="footer__nav-col" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <h3 class="footer__nav-heading">{{ block.settings.heading }}</h3>
                  {%- endif -%}
                  <ul class="footer__nav-list">
                    {%- if block.settings.menu != blank -%}
                      {%- for link in block.settings.menu.links -%}
                        <li><a href="{{ link.url }}" class="footer__link">{{ link.title }}</a></li>
                      {%- endfor -%}
                    {%- else -%}
                      {%- comment -%} menu 未設定時は manual_links (改行区切り "ラベル|URL") を表示 {%- endcomment -%}
                      {%- assign manual_pairs = block.settings.manual_links | strip | split: '
' -%}
                      {%- for pair in manual_pairs -%}
                        {%- assign parts = pair | split: '|' -%}
                        {%- if parts.size >= 2 -%}
                          <li><a href="{{ parts[1] | strip }}" class="footer__link">{{ parts[0] | strip }}</a></li>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                  </ul>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </nav>
        {%- endif -%}

        {%- comment -%} ----- Social（Standard / Sitemap で SNS 設定があれば表示）----- {%- endcomment -%}
        {%- if variant != 'minimal' and has_sns -%}
          <div class="footer__social">
            {%- if section.settings.social_heading != blank -%}
              <h3 class="footer__social-heading">{{ section.settings.social_heading }}</h3>
            {%- endif -%}
            <ul class="footer__social-list">
              {%- if section.settings.sns_instagram != blank -%}
                <li><a href="{{ section.settings.sns_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.71 3.71 0 01-1.38-.9 3.71 3.71 0 01-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.87 5.87 0 00-2.13 1.38A5.87 5.87 0 00.63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.79.73 1.46 1.38 2.13.67.66 1.34 1.07 2.13 1.38.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56.79-.31 1.46-.72 2.13-1.38.66-.67 1.07-1.34 1.38-2.13.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.87 5.87 0 00-1.38-2.13A5.87 5.87 0 0019.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84A6.16 6.16 0 0012 18.16 6.16 6.16 0 0012 5.84zm0 10.16A4 4 0 1112 8a4 4 0 010 8zm6.41-11.85a1.44 1.44 0 11-2.88 0 1.44 1.44 0 012.88 0z"/>
                  </svg>
                </a></li>
              {%- endif -%}
              {%- if section.settings.sns_youtube != blank -%}
                <li><a href="{{ section.settings.sns_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M23.5 6.2a3 3 0 00-2.12-2.12C19.5 3.56 12 3.56 12 3.56s-7.5 0-9.38.52A3 3 0 00.5 6.2C0 8.08 0 12 0 12s0 3.92.5 5.8a3 3 0 002.12 2.12c1.88.52 9.38.52 9.38.52s7.5 0 9.38-.52a3 3 0 002.12-2.12c.5-1.88.5-5.8.5-5.8s0-3.92-.5-5.8zM9.6 15.6V8.4l6.24 3.6-6.24 3.6z"/>
                  </svg>
                </a></li>
              {%- endif -%}
              {%- if section.settings.sns_note != blank -%}
                <li><a href="{{ section.settings.sns_note }}" target="_blank" rel="noopener" aria-label="note">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5.42 2.5h13.16c1.62 0 2.92 1.3 2.92 2.92v13.16c0 1.62-1.3 2.92-2.92 2.92H5.42a2.92 2.92 0 01-2.92-2.92V5.42c0-1.62 1.3-2.92 2.92-2.92zm2.1 5.27v8.48h1.78v-5.18l3.92 5.18h1.78V7.77h-1.78v5.18L9.3 7.77H7.52z"/>
                  </svg>
                </a></li>
              {%- endif -%}
              {%- if section.settings.sns_x != blank -%}
                <li><a href="{{ section.settings.sns_x }}" target="_blank" rel="noopener" aria-label="X (Twitter)">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117l11.966 15.644z"/>
                  </svg>
                </a></li>
              {%- endif -%}
              {%- if section.settings.sns_tiktok != blank -%}
                <li><a href="{{ section.settings.sns_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005.8 20.1a6.34 6.34 0 0010.86-4.43V8.69a8.16 8.16 0 004.77 1.52V6.69h-1.84z"/>
                  </svg>
                </a></li>
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}

      </div>
    </div>

    {%- comment -%} ===== BOTTOM ROW ===== {%- endcomment -%}
    <div class="footer__bottom">
      <div class="footer__bottom-inner">
        <p class="footer__copyright">
          © {{ 'now' | date: '%Y' }} {{ section.settings.copyright_name | default: shop.name }}. All rights reserved.
        </p>
        <ul class="footer__legal">
          {%- if section.settings.privacy_url != blank -%}
            <li><a href="{{ section.settings.privacy_url }}">Privacy</a></li>
          {%- endif -%}
          {%- if section.settings.terms_url != blank -%}
            <li><a href="{{ section.settings.terms_url }}">Terms</a></li>
          {%- endif -%}
          {%- if section.settings.legal_notice_url != blank -%}
            <li><a href="{{ section.settings.legal_notice_url }}">特商法に基づく表記</a></li>
          {%- endif -%}
        </ul>
      </div>
    </div>

  </footer>
</section>

{% schema %}
{
  "name": "Footer セクション",
  "tag": "section",
  "class": "fambox-footer-section",
  "settings": [
    {
      "type": "header",
      "content": "Variant"
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "options": [
        { "value": "standard", "label": "Standard（Brand + Nav + Social + Bottom）" },
        { "value": "minimal",  "label": "Minimal（Brand + Bottom のみ / LP・Checkout）" },
        { "value": "sitemap",  "label": "Sitemap（Nav 4 列・大規模サイト用）" }
      ],
      "default": "standard"
    },
    {
      "type": "header",
      "content": "── Brand Area ──"
    },
    {
      "type": "html",
      "id": "footer_logo_svg",
      "label": "ロゴ SVG（画像より優先 / White 推奨）"
    },
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "ロゴ画像（SVG 未設定時 / White 透過 PNG 推奨）"
    },
    {
      "type": "textarea",
      "id": "footer_tagline",
      "label": "タグライン（改行可）",
      "default": "アスリートの食を、もっと自由に。"
    },
    {
      "type": "header",
      "content": "── Social ──"
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Social 見出し",
      "default": "FOLLOW"
    },
    {
      "type": "url",
      "id": "sns_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "sns_youtube",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "sns_note",
      "label": "note URL"
    },
    {
      "type": "url",
      "id": "sns_x",
      "label": "X (Twitter) URL"
    },
    {
      "type": "url",
      "id": "sns_tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "header",
      "content": "── Bottom Row ──"
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Copyright 表記名",
      "default": "FAMBOX"
    },
    {
      "type": "url",
      "id": "privacy_url",
      "label": "Privacy Policy URL"
    },
    {
      "type": "url",
      "id": "terms_url",
      "label": "Terms of Service URL"
    },
    {
      "type": "url",
      "id": "legal_notice_url",
      "label": "特商法に基づく表記 URL"
    }
  ],
  "blocks": [
    {
      "type": "nav_column",
      "name": "Nav カラム",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "見出し（英語推奨 / Poppins）",
          "default": "ABOUT"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "メニュー（Shopify ナビ）"
        },
        {
          "type": "textarea",
          "id": "manual_links",
          "label": "リンク（menu 未設定時 / 1 行 1 リンク・形式: ラベル|URL）",
          "info": "例: 私たちについて|/pages/about"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer — Standard",
      "settings": {
        "variant": "standard",
