<!-- ============================================
     FAMBOX Bento Grid Section
     sections/fambox-bento-grid.liquid
     Spec:
       - brand/fambox/design-system/components/bento-grid.md (v0.2)
       - brand/fambox/design-system/components/bento-tile.md (v0.2)
     Figma Component Sets:
       - L4 Bento Grid: 91:107 (3 variants: standard / editorial / autofit)
       - L3 Bento Tile: 87:26 (40 variants: 4 variants × 5 sizes × 2 featured)
     ============================================
     Grid:  PC 12 col / Tablet 6 col / SP 1 col
     Tile:  4 variants × 5 sizes × 2 featured を 1 block 内で表現

     DNA 規律（spec §Anti 準拠）:
       - 同サイズ単調並列禁止 → 主役 2x2 を最低 1 個推奨
       - Drive 全タイル背景禁止 → variant に Drive 限定スタイルなし
       - タイル間隔 16px 未満禁止 → SP 16px / Tablet 24px / PC 32px 固定
       - 12 タイル以上禁止 → block limit 12
       - Glass + Image-fill mix-blend 禁止 → 互いに排他的 variant
     ============================================ -->
{%- liquid
  assign sec_id = 'fambox-bento-grid-' | append: section.id
  assign variant = section.settings.variant | default: 'standard'
  assign gap_size = section.settings.gap_size | default: 'md'
-%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&display=swap');

  /* ============================================
     RESET
     ============================================ */
  #{{ sec_id }},
  #{{ sec_id }} *,
  #{{ sec_id }} *::before,
  #{{ sec_id }} *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* ============================================
     SECTION BASE
     ============================================ */
  #{{ sec_id }} {
    width: 100%;
    background: {{ section.settings.bg_color }};
    font-family: var(--font-ja) !important;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  #{{ sec_id }} .bg__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: var(--space-7) var(--space-3);
  }
  @media (min-width: 768px) {
    #{{ sec_id }} .bg__inner {
      padding: var(--space-8) var(--space-6);
    }
  }

  /* ============================================
     HEADER
     ============================================ */
  #{{ sec_id }} .bg__header {
    margin-bottom: 56px;
    max-width: 720px;
  }
  #{{ sec_id }} .bg__eyebrow {
    font-family: var(--font-en) !important;
    font-size: var(--fs-body-sm) !important;
    font-weight: var(--fw-medium) !important;
    color: var(--color-drive) !important;
    letter-spacing: 0.12em !important;
    text-transform: uppercase !important;
    margin-bottom: var(--space-2) !important;
    display: block;
  }
  #{{ sec_id }} .bg__title {
    font-size: var(--fs-h2) !important;
    font-weight: var(--fw-semibold) !important;
    line-height: 1.5 !important;
    color: var(--color-ink) !important;
    margin: 0 !important;
  }
  @media (min-width: 768px) {
    #{{ sec_id }} .bg__title {
      font-size: var(--fs-h2-large) !important;
    }
  }
  #{{ sec_id }} .bg__lead {
    margin-top: var(--space-2) !important;
    font-size: var(--fs-body) !important;
    line-height: 1.75 !important;
    color: var(--color-sub) !important;
  }

  /* ============================================
     GRID（12 col PC / 6 col Tablet / 1 col SP）
     ============================================ */
  #{{ sec_id }} .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-rows: minmax(160px, auto);
    gap: var(--space-2);
    width: 100%;
  }
  @media (min-width: 768px) {
    #{{ sec_id }} .bento-grid {
      grid-template-columns: repeat(6, 1fr);
      grid-auto-rows: minmax(180px, auto);
      gap: var(--space-3);
    }
  }
  @media (min-width: 1024px) {
    #{{ sec_id }} .bento-grid {
      grid-template-columns: repeat(12, 1fr);
      grid-auto-rows: minmax(200px, auto);
      gap: var(--space-4);
    }
  }

  /* Gap modifier */
  #{{ sec_id }} .bento-gap--sm { gap: var(--space-2) !important; }
  #{{ sec_id }} .bento-gap--md { gap: var(--space-3) !important; }
  #{{ sec_id }} .bento-gap--lg { gap: var(--space-4) !important; }

  /* Auto-fit variant（dense packing）*/
  #{{ sec_id }} .bento-grid-autofit {
    grid-auto-flow: dense;
  }

  /* ============================================
     SIZES（PC 12 col + Tablet 6 col + SP 1 col）
     ============================================ */
  /* SP: 全 tile が 1 col 縦並び（DNA 既定） */
  #{{ sec_id }} .bento-tile {
    grid-column: span 1;
    grid-row: span 1;
  }

  /* Tablet（6 col）*/
  @media (min-width: 768px) {
    #{{ sec_id }} .tile-1x1 { grid-column: span 3; grid-row: span 1; }
    #{{ sec_id }} .tile-2x1 { grid-column: span 6; grid-row: span 1; }
    #{{ sec_id }} .tile-1x2 { grid-column: span 3; grid-row: span 2; }
    #{{ sec_id }} .tile-2x2 { grid-column: span 6; grid-row: span 2; }
    #{{ sec_id }} .tile-3x2 { grid-column: span 6; grid-row: span 2; }
  }

  /* PC（12 col）*/
  @media (min-width: 1024px) {
    #{{ sec_id }} .tile-1x1 { grid-column: span 3; grid-row: span 1; }
    #{{ sec_id }} .tile-2x1 { grid-column: span 6; grid-row: span 1; }
    #{{ sec_id }} .tile-1x2 { grid-column: span 3; grid-row: span 2; }
    #{{ sec_id }} .tile-2x2 { grid-column: span 6; grid-row: span 2; }
    #{{ sec_id }} .tile-3x2 { grid-column: span 9; grid-row: span 2; }
  }

  /* ============================================
     TILE 共通
     ============================================ */
  #{{ sec_id }} .bento-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-1-5);
    background: var(--color-white);
    border: 1px solid rgba(27, 29, 26, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    box-shadow: var(--shadow-1);
    overflow: hidden;
    color: var(--color-ink);
    text-decoration: none;
    transition: box-shadow var(--duration-base) var(--ease-out), transform var(--duration-base) var(--ease-out);
    isolation: isolate;
  }
  #{{ sec_id }} a.bento-tile:hover {
    box-shadow: var(--shadow-4);
    transform: translateY(-2px);
  }

  /* Featured（Drive 枠で主役識別 / Anti: Drive ベタ塗りではない）*/
  #{{ sec_id }} .bento-tile--featured {
    border: 2px solid var(--color-drive);
    box-shadow: 0 8px 24px rgba(252, 82, 20, 0.16);
  }

  #{{ sec_id }} .bento-tile__eyebrow {
    font-family: var(--font-en) !important;
    font-size: var(--fs-caption) !important;
    font-weight: var(--fw-medium) !important;
    color: var(--color-drive) !important;
    letter-spacing: 0.12em !important;
    text-transform: uppercase !important;
    margin: 0 !important;
    line-height: 1.4 !important;
  }
  #{{ sec_id }} .bento-tile__title {
    font-family: var(--font-ja) !important;
    font-size: var(--fs-body-lg) !important;
    font-weight: var(--fw-semibold) !important;
    color: var(--color-ink) !important;
    line-height: 1.5 !important;
    letter-spacing: normal !important;
    margin: 0 !important;
  }
  #{{ sec_id }} .bento-tile__text {
    font-size: var(--fs-body-sm) !important;
    line-height: 1.7 !important;
    color: var(--color-sub) !important;
    margin: 0 !important;
  }
  #{{ sec_id }} .bento-tile__link {
    margin-top: auto;
    font-family: var(--font-en) !important;
    font-size: var(--fs-caption-lg) !important;
    font-weight: var(--fw-semibold) !important;
    color: var(--color-drive) !important;
    text-decoration: none !important;
    letter-spacing: 0.04em !important;
  }

  /* ============================================
     VARIANT: Standard（Card 継承）
     ============================================ */
  #{{ sec_id }} .bento-standard {
    /* 既定スタイルそのまま */
  }

  /* ============================================
     VARIANT: Glass（背景画像 + opacity オーバーレイ）
     ============================================ */
  #{{ sec_id }} .bento-glass {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border: none;
    color: var(--color-white) !important;
  }
  #{{ sec_id }} .bento-glass::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, var(--glass-opacity, 0.3));
    z-index: 0;
  }
  #{{ sec_id }} .bento-glass > * {
    position: relative;
    z-index: 1;
  }
  #{{ sec_id }} .bento-glass .bento-tile__title,
  #{{ sec_id }} .bento-glass .bento-tile__text,
  #{{ sec_id }} .bento-glass .bento-tile__link {
    color: var(--color-white) !important;
  }
  #{{ sec_id }} .bento-glass--1 { --glass-opacity: 0.05; }
  #{{ sec_id }} .bento-glass--2 { --glass-opacity: 0.1; }
  #{{ sec_id }} .bento-glass--3 { --glass-opacity: 0.3; }
  #{{ sec_id }} .bento-glass--4 { --glass-opacity: 0.6; }
  #{{ sec_id }} .bento-glass--5 { --glass-opacity: 0.8; }

  /* ============================================
     VARIANT: Image-fill（画像が全面 + 下部 overlay）
     ============================================ */
  #{{ sec_id }} .bento-image-fill {
    padding: 0;
    border: none;
    background: var(--bg-tertiary);
  }
  #{{ sec_id }} .bento-image-fill .bento-tile__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    z-index: 0;
  }
  #{{ sec_id }} .bento-image-fill .bento-tile__overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 20px;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.32) 60%, rgba(0, 0, 0, 0) 100%);
    color: var(--color-white);
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  #{{ sec_id }} .bento-image-fill .bento-tile__title,
  #{{ sec_id }} .bento-image-fill .bento-tile__text {
    color: var(--color-white) !important;
  }

  /* ============================================
     VARIANT: Stat-focus（大型数字 56px Drive）
     ============================================ */
  #{{ sec_id }} .bento-stat-focus {
    justify-content: center;
    align-items: flex-start;
  }
  #{{ sec_id }} .bento-stat-focus__value {
    font-family: var(--font-en) !important;
    font-size: var(--fs-display) !important;
    font-weight: var(--fw-bold) !important;
    line-height: 1 !important;
    letter-spacing: -0.01em !important;
    color: var(--color-drive) !important;
    margin: 0 !important;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }
  @media (max-width: 767px) {
    #{{ sec_id }} .bento-stat-focus__value {
      font-size: var(--fs-h1) !important;
    }
  }
  #{{ sec_id }} .bento-stat-focus__unit {
    font-size: 0.4em !important;
    color: var(--color-sub) !important;
    font-weight: var(--fw-medium) !important;
  }
  #{{ sec_id }} .bento-stat-focus__label {
    margin-top: var(--space-1) !important;
    font-size: var(--fs-body) !important;
    color: var(--color-sub) !important;
    line-height: 1.6 !important;
  }
  #{{ sec_id }} .bento-stat-focus__period {
    margin-top: var(--space-0-5) !important;
    font-family: var(--font-en) !important;
    font-size: var(--fs-caption) !important;
    color: var(--color-caption) !important;
    letter-spacing: 0.04em !important;
  }

  /* ============================================
     prefers-reduced-motion
     ============================================ */
  @media (prefers-reduced-motion: reduce) {
    #{{ sec_id }} .bento-tile {
      transition: none !important;
    }
    #{{ sec_id }} a.bento-tile:hover {
      transform: none !important;
    }
  }
</style>

<section id="{{ sec_id }}">
  <div class="bg__inner">

    {%- if section.settings.eyebrow != blank or section.settings.title != blank or section.settings.lead != blank -%}
      <header class="bg__header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="bg__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="bg__title">{{ section.settings.title | newline_to_br }}</h2>
        {%- endif -%}
        {%- if section.settings.lead != blank -%}
          <p class="bg__lead">{{ section.settings.lead | newline_to_br }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="bento-grid bento-grid-{{ variant }} bento-gap--{{ gap_size }}">

      {%- for block in section.blocks -%}
        {%- if block.type == 'bento_tile' -%}
          {%- liquid
            assign t_variant = block.settings.tile_variant | default: 'standard'
            assign t_size = block.settings.tile_size | default: '1x1'
            assign t_featured = block.settings.featured
            assign t_glass = block.settings.glass_opacity | default: '3'
            assign t_class = 'bento-tile bento-' | append: t_variant | append: ' tile-' | append: t_size
            if t_variant == 'glass'
              assign t_class = t_class | append: ' bento-glass--' | append: t_glass
            endif
            if t_featured
              assign t_class = t_class | append: ' bento-tile--featured'
            endif

            assign tag = 'div'
            if block.settings.link_url != blank
              assign tag = 'a'
            endif
          -%}

          {%- comment -%} ===== Glass variant ===== {%- endcomment -%}
          {%- if t_variant == 'glass' -%}
            <{{ tag }}
              class="{{ t_class }}"
              {%- if tag == 'a' %} href="{{ block.settings.link_url }}"{% endif -%}
              {%- if block.settings.image != blank %} style="background-image: url('{{ block.settings.image | image_url: width: 1600 }}');"{% endif -%}
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.eyebrow != blank -%}
                <p class="bento-tile__eyebrow">{{ block.settings.eyebrow }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="bento-tile__title">{{ block.settings.title | newline_to_br }}</h3>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <p class="bento-tile__text">{{ block.settings.body | newline_to_br }}</p>
              {%- endif -%}
              {%- if block.settings.cta_label != blank -%}
                <span class="bento-tile__link">{{ block.settings.cta_label }} →</span>
              {%- endif -%}
            </{{ tag }}>

          {%- comment -%} ===== Image-fill variant ===== {%- endcomment -%}
          {%- elsif t_variant == 'image-fill' -%}
            <{{ tag }}
              class="{{ t_class }}"
              {%- if tag == 'a' %} href="{{ block.settings.link_url }}"{% endif -%}
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1800 | image_tag:
                  alt: block.settings.image_alt | default: block.settings.title,
                  loading: 'lazy',
                  class: 'bento-tile__media'
                }}
              {%- endif -%}
              <div class="bento-tile__overlay">
                {%- if block.settings.eyebrow != blank -%}
                  <p class="bento-tile__eyebrow" style="color: var(--color-white) !important;">{{ block.settings.eyebrow }}</p>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h3 class="bento-tile__title">{{ block.settings.title | newline_to_br }}</h3>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <p class="bento-tile__text">{{ block.settings.body | newline_to_br }}</p>
                {%- endif -%}
              </div>
            </{{ tag }}>

          {%- comment -%} ===== Stat-focus variant ===== {%- endcomment -%}
          {%- elsif t_variant == 'stat-focus' -%}
            <{{ tag }}
              class="{{ t_class }}"
              {%- if tag == 'a' %} href="{{ block.settings.link_url }}"{% endif -%}
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.eyebrow != blank -%}
                <p class="bento-tile__eyebrow">{{ block.settings.eyebrow }}</p>
              {%- endif -%}
              <p class="bento-stat-focus__value">
                {{ block.settings.stat_value }}{%- if block.settings.stat_unit != blank -%}<span class="bento-stat-focus__unit">{{ block.settings.stat_unit }}</span>{%- endif -%}
              </p>
              {%- if block.settings.stat_label != blank -%}
                <p class="bento-stat-focus__label">{{ block.settings.stat_label }}</p>
              {%- endif -%}
              {%- if block.settings.stat_period != blank -%}
                <p class="bento-stat-focus__period">{{ block.settings.stat_period }}</p>
              {%- endif -%}
            </{{ tag }}>

          {%- comment -%} ===== Standard variant（既定）===== {%- endcomment -%}
          {%- else -%}
            <{{ tag }}
              class="{{ t_class }}"
              {%- if tag == 'a' %} href="{{ block.settings.link_url }}"{% endif -%}
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.eyebrow != blank -%}
                <p class="bento-tile__eyebrow">{{ block.settings.eyebrow }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="bento-tile__title">{{ block.settings.title | newline_to_br }}</h3>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <p class="bento-tile__text">{{ block.settings.body | newline_to_br }}</p>
              {%- endif -%}
              {%- if block.settings.cta_label != blank -%}
                <span class="bento-tile__link">{{ block.settings.cta_label }} →</span>
              {%- endif -%}
            </{{ tag }}>
          {%- endif -%}

        {%- endif -%}
      {%- endfor -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bento Grid セクション",
  "tag": "section",
  "class": "fambox-bento-grid-section",
  "settings": [
    {
      "type": "header",
      "content": "Grid 設定"
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Grid Variant",
      "options": [
        { "value": "standard",  "label": "Standard（自由配置）" },
        { "value": "editorial", "label": "Editorial（対角線構図 + 主役 2x2 必須）" },
        { "value": "autofit",   "label": "Auto-fit（dense packing / KPI Grid）" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "gap_size",
      "label": "Gap サイズ",
      "options": [
        { "value": "sm", "label": "Small（情報密度高）" },
        { "value": "md", "label": "Medium（標準）" },
        { "value": "lg", "label": "Large（余白重視 / Brand 訴求）" }
      ],
      "default": "md"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景色",
      "default": "var(--bg-secondary)"
    },
    {
      "type": "header",
      "content": "── Header（任意）──"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "タイトル",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "リード文"
    }
  ],
  "blocks": [
    {
      "type": "bento_tile",
      "name": "Bento Tile",
      "limit": 12,
      "settings": [
        {
          "type": "select",
          "id": "tile_variant",
          "label": "Tile Variant",
          "options": [
            { "value": "standard",   "label": "Standard（Card 継承）" },
            { "value": "glass",      "label": "Glass（背景画像 + opacity）" },
            { "value": "image-fill", "label": "Image-fill（全面画像）" },
            { "value": "stat-focus", "label": "Stat-focus（大型数字）" }
          ],
          "default": "standard"
        },
        {
          "type": "select",
          "id": "tile_size",
          "label": "Tile Size (col × row)",
          "options": [
            { "value": "1x1", "label": "1×1（小タイル / 1/4 幅）" },
            { "value": "2x1", "label": "2×1（横長 / 1/2 幅）" },
            { "value": "1x2", "label": "1×2（縦長 / 2 行）" },
            { "value": "2x2", "label": "2×2（主役 / 1/2 幅 × 2 行）" },
            { "value": "3x2", "label": "3×2（メガ / 3/4 幅 × 2 行）" }
          ],
          "default": "1x1"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured（主役識別 Drive 枠）",
          "default": false
        },
        {
          "type": "header",
          "content": "── Glass / Image-fill 共通: 画像 ──"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "背景画像（Glass）/ 全面画像（Image-fill）"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "画像 alt（具体的に）"
        },
        {
          "type": "select",
          "id": "glass_opacity",
          "label": "Glass 不透明度（Glass variant 専用）",
          "options": [
            { "value": "1", "label": "1: 0.05（超薄）" },
            { "value": "2", "label": "2: 0.1（薄）" },
            { "value": "3", "label": "3: 0.3（既定 / 中）" },
            { "value": "4", "label": "4: 0.6（暗）" },
            { "value": "5", "label": "5: 0.8（強オーバーレイ）" }
          ],
          "default": "3"
        },
        {
          "type": "header",
          "content": "── テキスト ──"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow（英字小ラベル）"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "タイトル"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "本文 / サマリ"
        },
